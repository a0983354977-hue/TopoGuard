FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bpfcc-tools \
        build-essential \
        clang \
        libelf-dev \
        llvm \
        python3 \
        python3-bpfcc \
        python3-dev \
        python3-venv \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/topoguard-venv
ENV PATH="/opt/topoguard-venv/bin:${PATH}"
WORKDIR /opt/topoguard

COPY . .
RUN python -m pip install --no-cache-dir .

ENTRYPOINT ["topoguard-cli"]
